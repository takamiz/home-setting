[Unit]
Description=Wake-on-LAN Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/takamiz/services/wol
ExecStart=/home/takamiz/services/wol/venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 2 --threads 2 app:app
Environment=WOL_TARGET_MAC=98:ee:cb:d9:58:40
Environment=WOL_TARGET_IP=192.168.0.127
Environment=WOL_BROADCAST=192.168.0.255
Restart=on-failure

[Install]
WantedBy=default.target
